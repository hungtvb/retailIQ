# RetailIQ Week 1 — ONE OpenAI-compatible endpoint and ONE API key.
# Fill local .env; NEVER commit it, share it, or paste credentials into chat.
RETAILIQ_MODE=full
RETAILIQ_AS_OF=2026-10-28

# For Azure OpenAI v1: https://RESOURCE.openai.azure.com/openai/v1/
# For OpenAI: https://api.openai.com/v1/
# For other gateways: exactly the provider's OpenAI-compatible API base URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# OPTIONAL if the provider uses these exact model names.
# On Azure, these must be *deployment names*, which may differ from model IDs.
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# LLM_TEMPERATURE=    # optional; omit for models that reject temperature
# LLM_REASONING_EFFORT=none  # optional; match the provider/model requirements

# LangSmith tracing requires a LangSmith API key.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=retailiq-week1
LANGSMITH_API_KEY=

# Full-mode agentic supervisor, RAG guardrails, and runtime events.
RETAILIQ_SUPERVISOR_MODE=agentic
RETAILIQ_RAG_MIN_RELEVANCE=0.40
RETAILIQ_NATIVE_GRAPH_EVENTS=false
# RETAILIQ_CHECKPOINT_DB=data/agent_checkpoints.sqlite3
# Minimal Week 1 provider-call timeout; not a whole-request deadline.
RETAILIQ_PROVIDER_TIMEOUT_SECONDS=20
# Retry is limited to a provider SDK retry and two attempts for transient SQL reads.
# Approval, advanced resilience, long-term memory and governance remain future-week scope.
