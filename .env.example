# RetailIQ Week 1 — ONE OpenAI-compatible endpoint and ONE API key.
# Fill local .env; NEVER commit it, share it, or paste credentials into chat.
RETAILIQ_MODE=full
RETAILIQ_AS_OF=2026-10-28

# For Azure OpenAI v1: https://RESOURCE.openai.azure.com/openai/v1/
# For OpenAI: https://api.openai.com/v1/
# For other gateways: exactly the provider's OpenAI-compatible API base URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# OPTIONAL if the provider uses these exact model names.
# On Azure, these must be *deployment names*, which may differ from model IDs.
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# LLM_TEMPERATURE=    # optional; omit for models that reject temperature

# LangSmith is not required for local app operation, but tracing is in Week 1 rubric.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=retailiq-week1
# LANGSMITH_API_KEY=
